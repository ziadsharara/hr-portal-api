// Templated by cloudfront.tf's templatefile() call. Attached to the
// /api/* ordered_cache_behavior's viewer-request only — IP allowlist
// only, deliberately no SPA rewrite (see cloudfront_function.js.tftpl,
// used for the S3 default behavior, for that logic and for why
// enforceAllowlist is a baked-in runtime flag rather than a toggle on
// whether the function is attached at all).
//
// The API gets the same edge-level protection as the frontend it sits
// behind: neither has authentication of its own (see s3.tf / ec2.tf),
// so api_allowed_cidrs is the only access control either has.
function handler(event) {
    var enforceAllowlist = %{ if enforce_allowlist }true%{ else }false%{ endif };

    if (!enforceAllowlist) {
        return event.request;
    }

    var viewerIp = event.viewer.ip;
    var allowedCidrs = [
%{ for cidr in cidrs ~}
        "${cidr}",
%{ endfor ~}
    ];

    for (var i = 0; i < allowedCidrs.length; i++) {
        if (ipInCidr(viewerIp, allowedCidrs[i])) {
            return event.request;
        }
    }

    return {
        statusCode: 403,
        statusDescription: "Forbidden",
        body: {
            encoding: "text",
            data: "Forbidden"
        }
    };
}

function ipInCidr(ip, cidr) {
    var parts = cidr.split("/");
    var prefixLength = parseInt(parts[1], 10);

    if (isNaN(prefixLength) || prefixLength < 0 || prefixLength > 32) {
        return false;
    }

    var ipInt = ipToInt(ip);
    var baseInt = ipToInt(parts[0]);

    if (ipInt === null || baseInt === null) {
        return false;
    }

    var mask = prefixLength === 0 ? 0 : (0xFFFFFFFF << (32 - prefixLength)) >>> 0;

    return (ipInt & mask) === (baseInt & mask);
}

function ipToInt(ip) {
    var octets = ip.split(".");

    if (octets.length !== 4) {
        return null;
    }

    var result = 0;

    for (var i = 0; i < 4; i++) {
        var octet = parseInt(octets[i], 10);

        if (isNaN(octet) || octet < 0 || octet > 255) {
            return null;
        }

        result = (result << 8) | octet;
    }

    return result >>> 0;
}
