# Copy to .env.compose and fill in local values, then:
#   docker compose --env-file .env.compose up --build
#
# Named .env.compose (not .env) deliberately, so it never collides with
# this project's own app-level .env conventions. These are LOCAL DEV
# values only — never put real credentials here, and never commit the
# resulting .env.compose file (it's already gitignored).

# --- MySQL ---------------------------------------------------------
MYSQL_ROOT_PASSWORD=local-dev-root-pw
MYSQL_DATABASE=hr_portal
MYSQL_USER=hr_portal_app
MYSQL_PASSWORD=local-dev-app-pw
MYSQL_PORT=3306

# --- Ports exposed on your host machine -----------------------------
BACKEND_PORT=8080
FRONTEND_PORT=5173

# --- Frontend build arg ---------------------------------------------
# Relative path works for local docker-compose (frontend's nginx proxies
# /api/* to the backend container) and matches what AWS uses too. Only
# override if you have a reason to point the built frontend at a
# different backend URL entirely.
VITE_API_BASE_URL=/api
