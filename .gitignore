target/
*.class

# Local dev/testing output only — never used by the app itself
local-output/

.idea/
*.iml

# Local Claude Code tool config — machine-specific paths, not app config
.claude/

# Any local env file (.env, .env.compose, .env.local, ...) — never commit
# real credentials. Keep the checked-in .example templates tracked.
.env*
!.env*.example

# Terraform (** so this also catches nested infra subdirectories, not
# just infra/ itself)
infra/**/.terraform/
infra/**/*.tfstate*
# Both spellings: `-out=tfplan` produces a file with no extension, which
# `*.tfplan` does not match. Plan files embed sensitive values (the
# generated DB passwords among them), so a miss here leaks credentials.
infra/**/*.tfplan
infra/**/tfplan*
infra/**/.terraform.lock.hcl
infra/**/*.tfvars
!infra/**/*.tfvars.example
